{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Referral Program API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ReferralProgram",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a community's referral program activity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/referral-program",
            "params": [
              {
                "name": "communityId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a community's referral program activity"
        },
        {
          "info": {
            "name": "Update a community's referral program incentives",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/referral-program",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a community's referral program incentives"
        }
      ]
    }
  ],
  "bundled": true
}