{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Application API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Application",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve an individual application.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/action-groups/:id/application",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of action group"
              },
              {
                "name": "communityId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve an individual application."
        },
        {
          "info": {
            "name": "Update an application for an action group.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/action-groups/:id/application",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of action group"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an application for an action group."
        },
        {
          "info": {
            "name": "Create a submission for an application.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/action-groups/:id/submissions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of action group"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a submission for an application."
        },
        {
          "info": {
            "name": "getApplicationFlow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:actionGroupId/application-flow",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}