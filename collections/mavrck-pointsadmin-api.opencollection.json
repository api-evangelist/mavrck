{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Points Admin API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "PointsAdmin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getCommunityActionObjectiveDefinitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/points-admin/action-objective-definition"
          }
        },
        {
          "info": {
            "name": "setCommunityActionObjectiveDefinition",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/v1/points-admin/action-objective-definition",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "getEngagementPointMapping",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/points-admin/engagement-point-mapping"
          }
        },
        {
          "info": {
            "name": "setEngagementPointMapping",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/v1/points-admin/engagement-point-mapping",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}