{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Meta Ad Admin API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meta Ad Admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetSystemUsersAdAccountsInfo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/admin/meta/system-users/ad-accounts"
          }
        },
        {
          "info": {
            "name": "backfillAdAccountInsightsData",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/admin/meta/backfill/ad-insights",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "pushAdAccountInsightsData",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/admin/meta/backfill/ad-insights/push",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "backfillAdInformationForAdAccount",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/admin/meta/backfill/ads",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "backfillLifetimeAdInsights",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/admin/meta/backfill/ads/lifetime-insights",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}