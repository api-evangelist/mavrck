{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Shopify Account API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ShopifyAccount",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getInstanceShopifyAccount",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts"
          }
        },
        {
          "info": {
            "name": "createShopifyAccount",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "uninstallShopifyAccount",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/uninstall",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "shopifyInstall",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/install"
          }
        },
        {
          "info": {
            "name": "shopifyAuth",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/auth"
          }
        },
        {
          "info": {
            "name": "connectShopifyApp",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/connect",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "uninstallShopifyApp",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/webhooks/uninstall",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "shopRedact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/webhooks/compliance/shop/redact",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "customerRedact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/webhooks/compliance/customers/redact"
          }
        },
        {
          "info": {
            "name": "customerDataRequest",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/shopify-accounts/webhooks/compliance/customers/data_request"
          }
        }
      ]
    }
  ],
  "bundled": true
}