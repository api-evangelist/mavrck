{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Campaign Application API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CampaignApplication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "submitCampaignApplication",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/external-campaign-application",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "linkMavely",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/external-campaign-application/connect-mavely",
            "params": [
              {
                "name": "mavely_profile_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "connectMavelyUrl",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/external-campaign-application/connect-mavely/url",
            "params": [
              {
                "name": "global_user_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "action_group_id",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}