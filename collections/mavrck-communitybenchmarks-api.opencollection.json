{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Community Benchmarks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CommunityBenchmarks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves benchmarks for a community",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/community-benchmarks",
            "params": [
              {
                "name": "fromDate",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves benchmarks for a community"
        }
      ]
    }
  ],
  "bundled": true
}