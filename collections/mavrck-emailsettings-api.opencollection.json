{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Email Settings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "EmailSettings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getCurrentEmailSettings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/smtp-email"
          }
        },
        {
          "info": {
            "name": "updateEmailSettings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/v1/smtp-email/:fromName/:fromEmail",
            "params": [
              {
                "name": "fromName",
                "value": "",
                "type": "path"
              },
              {
                "name": "fromEmail",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/email-settings",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "post",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/email-settings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}