                "description": "Maximum number of items to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip"
              },
              {
                "name": "orderDirection",
                "value": "",
                "type": "query",
                "description": "Select the direction by which the data will be ordered, ascending or descending."
              },
              {
                "name": "userFilter",
                "value": "",
