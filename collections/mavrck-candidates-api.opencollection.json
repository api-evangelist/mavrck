        {
          "info": {
            "name": "Update the status of candidates.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/action-groups/:id/candidates",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of action group"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the status of candidates."
        },
        {
          "info": {
            "name": "Retrieve a candidate of an action group.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/action-groups/:actionGroupId/candidates/:globalUserId",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path",
                "description": "ID of action group"
              },
              {
                "name": "globalUserId",
                "value": "",
                "type": "path",
                "description": "ID of the global user"
              }
            ]
