              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "campaignId",
                "value": "",
                "type": "query"
              },
              {
                "name": "reportingGroupId",
                "value": "",
                "type": "query"
              },
              {
                "name": "groupBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "communityIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "networks",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a report"
        }
      ]
    }
  ],
  "bundled": true
}