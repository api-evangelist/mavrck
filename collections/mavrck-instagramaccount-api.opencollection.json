{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Instagram Account API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "InstagramAccount",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "updateInstagramProfilePicture",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/instagram-profiles/update-profile-picture",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "activateInstagramProfile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/instagram-profiles/:instagramProfileId/active",
            "params": [
              {
                "name": "instagramProfileId",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}