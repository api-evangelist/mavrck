{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Points API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Points",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the points history for an influencer.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/influencers/:membershipId/points-history",
            "params": [
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Attribute to order by."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip"
              },
              {
                "name": "membershipId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the points history for an influencer."
        },
        {
          "info": {
            "name": "Grant points for an influencer in a manual entry.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/influencers/:membershipId/points-history",
            "params": [
              {
                "name": "membershipId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Grant points for an influencer in a manual entry."
        }
      ]
    }
  ],
  "bundled": true
}