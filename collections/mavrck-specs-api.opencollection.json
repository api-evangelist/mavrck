{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Specs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Specs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getSpecs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:id/specs",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "title",
                "value": "",
                "type": "query"
              },
              {
                "name": "destinationUrl",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeCommissions",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "postSpecs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:id/specs",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "updateSpecs",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:id/specs/:specId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "specId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "archiveSpec",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:id/specs/:specId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "specId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "getBrandDetails",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:id/specs/brand-details",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "link",
                "value": "",
                "type": "query"
              },
              {
                "name": "metadataIncluded",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}