          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/action-groups/:actionGroupId/list-members/:globalUserId",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "globalUserId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Send a message to specified List Member."
        },
        {
          "info": {
            "name": "If necessary, return campaign setup alert to marketer.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/action-groups/:id/setup-alerts",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "alert",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "If necessary, return campaign setup alert to marketer."
        },
        {
