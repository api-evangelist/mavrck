                "name": "actionGroupId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send a message to specified action group candidates."
        },
        {
          "info": {
            "name": "Send a message to specified List Member.",
            "type": "http"
