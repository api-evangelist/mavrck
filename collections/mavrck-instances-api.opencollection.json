              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "deleteInstanceBranding",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://app.splashscore.com/v1/v1/s4-instance-branding/:brandingId",
            "params": [
              {
                "name": "brandingId",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}