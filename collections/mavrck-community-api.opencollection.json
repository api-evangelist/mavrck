{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Community API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Community",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getCommunityInfoWithAffiliates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/comm-info"
          }
        },
        {
          "info": {
            "name": "updateCommmunityInfo",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/v1/comm-info",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "getCommunityInfo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/comm/:communityId/info",
            "params": [
              {
                "name": "communityId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "getCommunityNews",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/comm/:communityId/news",
            "params": [
              {
                "name": "communityId",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}