{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Event Logs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "EventLogs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getEventLogs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/event-logs",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query"
              },
              {
                "name": "resourceType",
                "value": "",
                "type": "query"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "query"
              },
              {
                "name": "invokedBy",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "postEventLog",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/event-logs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}