{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Anonymous Comments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "AnonymousComments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "queryAnonymousComments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:actionGroupId/global-users/:globalUserId/anonymous-comments",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "globalUserId",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "orderDirection",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "createAnonymousComment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:actionGroupId/global-users/:globalUserId/anonymous-comments",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "globalUserId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}