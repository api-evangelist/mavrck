{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Email Suppressions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Email Suppressions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "deleteEmailBlocklist",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://app.splashscore.com/v1/v1/email-blocklist/:email",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "path",
                "description": "The email address to remove from blocklists"
              }
            ]
          },
          "docs": "Remove an email address from all SendGrid suppression groups.\nThis endpoint will attempt to remove the specified email from all existing\nsuppression groups (bounces, blocks, spam reports, unsubscribes, etc.)"
        }
      ]
    }
  ],
  "bundled": true
}