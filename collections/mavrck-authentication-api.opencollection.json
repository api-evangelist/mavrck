            "params": [
              {
                "name": "^mdp_.+$",
                "value": "",
                "type": "query",
                "description": "Pass in data points on sign-up, in the format mdp_{data_point_definition_key}"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api-key",
              "value": "{{api-key}}",
              "placement": "header"
            }
          },
