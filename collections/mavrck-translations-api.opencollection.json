{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Translations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Translations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "fetchAvailableLocales",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/translations/fetch-available-locales"
          }
        }
      ]
    }
  ],
  "bundled": true
}