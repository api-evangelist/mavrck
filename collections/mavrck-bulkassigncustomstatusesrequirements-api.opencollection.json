{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Bulk Assign Custom Statuses Requirements API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "BulkAssignCustomStatusesRequirements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getRequirements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/action-groups/:actionGroupId/bulk-assign-custom-statuses-requirements",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "listId",
                "value": "",
                "type": "query"
              },
              {
                "name": "expectedNumberOfInfluencers",
                "value": "",
                "type": "query"
              },
              {
                "name": "currentCustomStatusId",
                "value": "",
                "type": "query"
              },
              {
                "name": "targetCustomStatusId",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}