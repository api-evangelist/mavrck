{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Influencers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Influencers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a list of influencers.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/influencers",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search for influencer by first name, last name, and email."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip"
              }
            ]
          },
          "docs": "Retrieve a list of influencers."
        }
      ]
    }
  ],
  "bundled": true
}