{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Program API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Program",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getReferralProgram",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/programs/referral-program"
          },
          "docs": "Get the referral program for a given community, including the program's incentives"
        }
      ]
    }
  ],
  "bundled": true
}