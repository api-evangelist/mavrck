{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO List Member API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ListMember",
        "type": "folder"
      },
      "items": [
        {
          "info": {
