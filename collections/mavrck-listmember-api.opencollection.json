            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/list-members/:actionGroupId",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "participating",
                "value": "",
                "type": "query"
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Attribute to order by."
              },
              {
                "name": "orderDirection",
                "value": "",
                "type": "query",
                "description": "Select the direction by which the data will be ordered, ascending or descending."
              }
            ]
          },
          "docs": "Retrieve an action group's list members."
        },
        {
          "info": {
            "name": "Update multiple list members.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/list-members/:actionGroupId",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update multiple list members."
        },
        {
          "info": {
            "name": "Retrieve a list member.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/list-members/:actionGroupId/:globalUserId",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path",
                "description": "ID of action group"
              },
              {
                "name": "globalUserId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a list member."
        },
        {
          "info": {
            "name": "Update a list member.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/list-members/:actionGroupId/:globalUserId",
            "params": [
              {
                "name": "actionGroupId",
                "value": "",
                "type": "path"
              },
              {
                "name": "globalUserId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a list member."
        }
      ]
    }
  ],
  "bundled": true
