{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Features API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getFeatures",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/features"
          }
        },
        {
          "info": {
            "name": "getFeatureById",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/features/:featureId",
            "params": [
              {
                "name": "featureId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "updateFeature",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "http://app.splashscore.com/v1/v1/features/:featureId",
            "params": [
              {
                "name": "featureId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}