{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAVRCK.IO Ytbc Brand Channels API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "YtbcBrandChannels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "validateBrandYoutubeChannel",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://app.splashscore.com/v1/v1/ytbc/brand-channels/validate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "getBrandYoutubeChannel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://app.splashscore.com/v1/v1/ytbc/brands/:brandId/youtube-channel",
            "params": [
              {
                "name": "brandId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "setBrandYoutubeChannel",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://app.splashscore.com/v1/v1/ytbc/brands/:brandId/youtube-channel",
            "params": [
              {
                "name": "brandId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "clearBrandYoutubeChannel",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://app.splashscore.com/v1/v1/ytbc/brands/:brandId/youtube-channel",
            "params": [
              {
                "name": "brandId",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}