              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "orderProperty",
                "value": "",
                "type": "query"
              },
              {
                "name": "orderDirection",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
